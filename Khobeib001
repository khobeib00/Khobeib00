UNICODE_PIECES = {
    'r': '♜', 'n': '♞', 'b': '♝', 'q': '♛', 'k': '♚', 'p': '♟',
    'R': '♖', 'N': '♘', 'B': '♗', 'Q': '♕', 'K': '♔', 'P': '♙',
    '.': ' '
}

def get_board_keyboard(board: chess.Board, selected_sq=None, legal_moves=None):
    if legal_moves is None:
        legal_moves = []
        
    markup = types.InlineKeyboardMarkup(row_width=8)
    buttons = []
    
    for rank in range(7, -1, -1):
        for file in range(8):
            sq = chess.square(file, rank)
            piece = board.piece_at(sq)
            symbol = UNICODE_PIECES[piece.symbol()] if piece else ' '
            
            if selected_sq == sq:
                display = f"[{symbol if symbol != ' ' else '🔹'}]"
            elif sq in legal_moves:
                display = "🟢" if symbol == ' ' else "🎯"
            else:
                display = symbol if symbol != ' ' else '·'
                
            buttons.append(types.InlineKeyboardButton(text=display, callback_data=f"sq_{sq}"))
            
    markup.add(*buttons)
    markup.row(
        types.InlineKeyboardButton("❌ إلغاء التحديد", callback_data="action_cancel"),
        types.InlineKeyboardButton("🏳️ استسلام", callback_data="action_resign")
    )
    return markup

def get_promotion_keyboard(from_sq, to_sq):
    markup = types.InlineKeyboardMarkup(row_width=2)
    markup.add(
        types.InlineKeyboardButton("♛ وزير", callback_data=f"prom_{from_sq}_{to_sq}_q"),
        types.InlineKeyboardButton("♜ قلعة", callback_data=f"prom_{from_sq}_{to_sq}_r"),
        types.InlineKeyboardButton("♝ فيل", callback_data=f"prom_{from_sq}_{to_sq}_b"),
        types.InlineKeyboardButton("♞ حصان", callback_data=f"prom_{from_sq}_{to_sq}_n")
    )
    return markup

