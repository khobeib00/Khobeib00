    lang = get_lang(message.chat.id)
    if not check_subscriptions(message.from_user.id):
        send_sub_request(message.chat.id, lang, pending_action="invitechess")
        return

    if not message.reply_to_message:
        bot.reply_to(message, get_text(lang, 'invite_need_reply'))
        return

    target_user = message.reply_to_message.from_user
    inviter = message.from_user

    games[message.chat.id] = ChessGame(
        chat_id=message.chat.id,
        mode="private",
        target_user_id=target_user.id,
        inviter_id=inviter.id
    )

    markup = types.InlineKeyboardMarkup()
    markup.add(types.InlineKeyboardButton(get_text(lang, 'btn_accept_invite'), callback_data="join:accept_invite"))

    text = get_text(lang, 'invite_sent', inviter=inviter.first_name, invited=target_user.first_name)
    bot.send_message(message.chat.id, text, reply_markup=markup)

@bot.message_handler(commands=['endchess'])
def cmd_endchess(message):
    lang = get_lang(message.chat.id)
    game = games.get(message.chat.id)
    if not game:
        bot.reply_to(message, get_text(lang, 'no_active_game'))
        return

    user_id = message.from_user.id
    is_authorized = False

    # Check if group owner/admin or playing vs bot
    if message.chat.type in ['group', 'supergroup']:
        cm = bot.get_chat_member(message.chat.id, user_id)
        if cm.status in ['creator', 'administrator']:
            is_authorized = True

    if game.mode == "vs_bot" and user_id == game.white_id:
        is_authorized = True

    if is_authorized:
        del games[message.chat.id]
        bot.reply_to(message, get_text(lang, 'game_ended_manual', user=message.from_user.first_name))
    else:
        bot.reply_to(message, get_text(lang, 'not_authorized_end'))

# ==================== Callbacks Handler ====================
@bot.callback_query_handler(func=lambda call: True)
def handle_callbacks(call):
    bot.answer_callback_query(call.id) # Fast response optimization
    
    chat_id = call.message.chat.id
    user_id = call.from_user.id
    data = call.data
    lang = get_lang(chat_id)

    # Change Language
    if data.startswith("setlang:"):
        new_lang = data.split(":")[1]
        chat_languages[str(chat_id)] = new_lang
        save_languages()
        bot.edit_message_text(get_text(new_lang, 'lang_selected'), chat_id, call.message.message_id)
        return

    # Check Subscription Callback
    if data.startswith("check_sub:"):
        if check_subscriptions(user_id):
            bot.send_message(chat_id, get_text(lang, 'sub_verified'))
            try:
                bot.delete_message(chat_id, call.message.message_id)
            except Exception:
                pass
        else:
            bot.answer_callback_query(call.id, get_text(lang, 'not_subbed_toast'), show_alert=True)
        return

    # Joining Game logic
    if data.startswith("join:"):
        action = data.split(":")[1]
        
        if action == "bot":
            game = ChessGame(chat_id, mode="vs_bot")
            game.white_id = user_id
            game.white_name = call.from_user.first_name
            game.black_id = 0
            game.black_name = "Bot 🤖"
            games[chat_id] = game
            game.start_timers()
            
            msg = bot.send_message(chat_id, make_board_text(game, lang), reply_markup=render_board_markup(game), parse_mode="Markdown")
            game.msg_id = msg.message_id
            return

        if action == "pvp":
            game = games.get(chat_id)
            if not game:
                game = ChessGame(chat_id, mode="pvp")
                games[chat_id] = game
            
            if not game.white_id:
                game.white_id = user_id
                game.white_name = call.from_user.first_name
                bot.send_message(chat_id, f"✅ انضم {game.white_name} كاللاعب الأبيض! بانتظار الخصم...")
            elif not game.black_id and user_id != game.white_id:
                game.black_id = user_id
                game.black_name = call.from_user.first_name
                game.start_timers()
                
                msg = bot.send_message(chat_id, make_board_text(game, lang), reply_markup=render_board_markup(game), parse_mode="Markdown")
                game.msg_id = msg.message_id
            else:
                bot.answer_callback_query(call.id, get_text(lang, 'places_full'), show_alert=True)
            return

        if action == "accept_invite":
            game = games.get(chat_id)
            if not game or game.mode != "private":
                return
            
            if user_id != game.target_user_id:
                bot.answer_callback_query(call.id, get_text(lang, 'invite_not_for_you'), show_alert=True)
                return
            
            game.white_id = game.inviter_id
            game.white_name = "White Player"
            game.black_id = user_id
            game.black_name = call.from_user.first_name
            game.start_timers()

            msg = bot.send_message(chat_id, make_board_text(game, lang), reply_markup=render_board_markup(game), parse_mode="Markdown")
            game.msg_id = msg.message_id
            return

    # Board Cell Selection
    if data.startswith("cell:"):
        game = games.get(chat_id)
        if not game:
            return

        # Player Check
        if user_id not in [game.white_id, game.black_id]:
            bot.answer_callback_query(call.id, get_text(lang, 'not_a_player'), show_alert=True)
            return

        # Turn Check
        current_turn_id = game.white_id if game.board.turn == chess.WHITE else game.black_id
        if user_id != current_turn_id:
            bot.answer_callback_query(call.id, get_text(lang, 'not_your_turn'), show_alert=True)
            return

        # Check Timers
        game.update_timer()
        if game.is_time_out():
            loser = game.white_name if game.white_time <= 0 else game.black_name
            winner = game.black_name if game.white_time <= 0 else game.white_name
            bot.send_message(chat_id, get_text(lang, 'time_out', loser=loser, winner=winner))
            del games[chat_id]
            return

        sq = int(data.split(":")[1])

        if game.selected_square is None:
            piece = game.board.piece_at(sq)
            if piece and ((piece.color == chess.WHITE and user_id == game.white_id) or
                          (piece.color == chess.BLACK and user_id == game.black_id)):
                game.selected_square = sq
        else:
            move = chess.Move(game.selected_square, sq)
            if move in game.board.legal_moves:
                process_move(chat_id, move)
            else:
                # Select another own piece or deselect
                piece = game.board.piece_at(sq)
                if piece and ((piece.color == chess.WHITE and user_id == game.white_id) or
                              (piece.color == chess.BLACK and user_id == game.black_id)):
                    game.selected_square = sq
                else:
                    game.selected_square = None

        # Refresh Board View
        try:
            bot.edit_message_text(
                make_board_text(game, lang),
                chat_id,
                call.message.message_id,
                reply_markup=render_board_markup(game),
                parse_mode="Markdown"
            )
        except Exception:
            pass

