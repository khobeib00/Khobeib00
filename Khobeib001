# ==================== Chess Game Core ====================
games = {} # Key: chat_id

UNICODE_PIECES = {
    'R': '♖', 'N': '♘', 'B': '♗', 'Q': '♕', 'K': '♔', 'P': '♙',
    'r': '♜', 'n': '♞', 'b': '♝', 'q': '♛', 'k': '♚', 'p': '♟'
}

class ChessGame:
    def __init__(self, chat_id, mode="pvp", target_user_id=None, inviter_id=None):
        self.chat_id = chat_id
        self.mode = mode  # pvp, vs_bot, private
        self.target_user_id = target_user_id
        self.inviter_id = inviter_id
        self.board = chess.Board()
        self.white_id = None
        self.black_id = None
        self.white_name = ""
        self.black_name = ""
        self.selected_square = None
        self.last_move = None
        self.time_control = 1200 # 20 mins
        self.white_time = 1200
        self.black_time = 1200
        self.last_turn_time = None
        self.msg_id = None

    def start_timers(self):
        self.last_turn_time = time.time()

    def update_timer(self):
        if not self.last_turn_time:
            return
        now = time.time()
        elapsed = now - self.last_turn_time
        if self.board.turn == chess.WHITE:
            self.white_time -= elapsed
        else:
            self.black_time -= elapsed
        self.last_turn_time = now

    def is_time_out(self):
        return self.white_time <= 0 or self.black_time <= 0

def format_time(seconds):
    mins, secs = divmod(max(0, int(seconds)), 60)
    return f"{mins:02d}:{secs:02d}"

def render_board_markup(game):
    markup = types.InlineKeyboardMarkup(row_width=8)
    for row in range(7, -1, -1):
        buttons = []
        for col in range(8):
            sq = chess.square(col, row)
            sq_name = chess.square_name(sq)
            piece = game.board.piece_at(sq)
            
            label = UNICODE_PIECES.get(piece.symbol(), " ") if piece else " "
            
            # Highlightings
            if game.selected_square == sq:
                label = f"🔷{label.strip()}"
            elif game.last_move and sq in [game.last_move.from_square, game.last_move.to_square]:
                label = f"▫️{label.strip()}"
                
            buttons.append(types.InlineKeyboardButton(text=label, callback_data=f"cell:{sq}"))
        markup.add(*buttons)
    return markup

def make_board_text(game, lang):
    w_time = format_time(game.white_time)
    b_time = format_time(game.black_time)
    
    turn_str = "الأبيض (White)" if game.board.turn == chess.WHITE else "الأسود (Black)"
    
    text = (
        f"♔ {game.white_name} ({w_time}) 🆚 ♚ {game.black_name} ({b_time})\n"
        f"🎯 الدور الحالي: **{turn_str}**\n"
    )
    if game.board.is_check():
        text += "⚠️ **كش ملك (Check)!**\n"
    return text

# ==================== Bot Actions & Move Execution ====================
def process_move(chat_id, move):
    game = games.get(chat_id)
    if not game:
        return
    
    game.update_timer()
    
    # Check capture for notification
    is_capture = game.board.is_capture(move)
    dest_sq = chess.square_name(move.to_square)
    player_name = game.white_name if game.board.turn == chess.WHITE else game.black_name
    
    # Auto Promotion to Queen
    if game.board.piece_at(move.from_square).piece_type == chess.PAWN:
        if chess.square_rank(move.to_square) in [0, 7]:
            move.promotion = chess.QUEEN

    game.board.push(move)
    game.last_move = move
    game.selected_square = None
    
    lang = get_lang(chat_id)
    
    if is_capture:
        bot.send_message(chat_id, get_text(lang, 'capture_msg', player=player_name, square=dest_sq))

    # Check Game End
    if game.board.is_checkmate():
        winner = game.white_name if game.board.turn == chess.BLACK else game.black_name
        bot.send_message(chat_id, get_text(lang, 'checkmate', winner=winner))
        del games[chat_id]
        return
    elif game.board.is_stalemate():
        bot.send_message(chat_id, get_text(lang, 'stalemate'))
        del games[chat_id]
        return
    elif game.board.is_game_over():
        bot.send_message(chat_id, get_text(lang, 'draw'))
        del games[chat_id]
        return

    # Trigger Bot Move if Vs Bot
    if game.mode == "vs_bot" and game.board.turn == chess.BLACK:
        bot_move()

def bot_move(chat_id):
    game = games.get(chat_id)
    if not game:
        return
    legal = list(game.board.legal_moves)
    if legal:
        selected_move = random.choice(legal)
        process_move(chat_id, selected_move)

