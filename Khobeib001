def init_db():
    with sqlite3.connect(DB_NAME) as conn:
        cursor = conn.cursor()
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT,
                elo INTEGER DEFAULT 1200,
                wins INTEGER DEFAULT 0,
                losses INTEGER DEFAULT 0,
                draws INTEGER DEFAULT 0
            )
        ''')
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS games (
                chat_id INTEGER PRIMARY KEY,
                fen TEXT NOT NULL,
                white_id INTEGER NOT NULL,
                black_id INTEGER NOT NULL,
                selected_sq INTEGER DEFAULT NULL
            )
        ''')
        conn.commit()

init_db()

def get_or_create_user(user_id, username):
    with sqlite3.connect(DB_NAME) as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT user_id FROM users WHERE user_id = ?", (user_id,))
        if not cursor.fetchone():
            cursor.execute(
                "INSERT INTO users (user_id, username) VALUES (?, ?)", 
                (user_id, username or f"Player_{user_id}")
            )
            conn.commit()

def save_game(chat_id, board, white_id, black_id, selected_sq=None):
    with sqlite3.connect(DB_NAME) as conn:
        cursor = conn.cursor()
        cursor.execute('''
            INSERT INTO games (chat_id, fen, white_id, black_id, selected_sq)
            VALUES (?, ?, ?, ?, ?)
            ON CONFLICT(chat_id) DO UPDATE SET
                fen = excluded.fen,
                selected_sq = excluded.selected_sq
        ''', (chat_id, board.fen(), white_id, black_id, selected_sq))
        conn.commit()

def load_game(chat_id):
    with sqlite3.connect(DB_NAME) as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT fen, white_id, black_id, selected_sq FROM games WHERE chat_id = ?", (chat_id,))
        row = cursor.fetchone()
        if row:
            return {
                'board': chess.Board(row[0]),
                'white': row[1],
                'black': row[2],
                'selected': row[3]
            }
    return None

def delete_game(chat_id):
    with sqlite3.connect(DB_NAME) as conn:
        cursor = conn.cursor()
        cursor.execute("DELETE FROM games WHERE chat_id = ?", (chat_id,))
        conn.commit()

