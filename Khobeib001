@bot.message_handler(commands=['botgame'])
def start_bot_game(message):
    chat_id = message.chat.id
    get_or_create_user(message.from_user.id, message.from_user.username)
    board = chess.Board()
    save_game(chat_id, board, white_id=message.from_user.id, black_id=-1)
    
    bot.send_message(
        chat_id, 
        "بدأت المباراة! دورك الآن (الأبيض):", 
        reply_markup=get_board_keyboard(board)
    )

@bot.callback_query_handler(func=lambda call: call.data.startswith('sq_'))
def handle_square_click(call):
    chat_id = call.message.chat.id
    game = load_game(chat_id)
    
    if not game:
        bot.answer_callback_query(call.id, "لا توجد لعبة قائمة. أرسل /botgame")
        return

    board = game['board']
    sq = int(call.data.split('_')[1])
    
    # 1. تحديد القطعة
    if game['selected'] is None:
        piece = board.piece_at(sq)
        if piece and piece.color == chess.WHITE:
            save_game(chat_id, board, game['white'], game['black'], selected_sq=sq)
            legal_destinations = [m.to_square for m in board.legal_moves if m.from_square == sq]
            bot.edit_message_reply_markup(
                chat_id, call.message.message_id, 
                reply_markup=get_board_keyboard(board, selected_sq=sq, legal_moves=legal_destinations)
            )
            
    # 2. تحريك القطعة
    else:
        from_sq = game['selected']
        
        # ترقية البيذق
        is_pawn = board.piece_at(from_sq) and board.piece_at(from_sq).piece_type == chess.PAWN
        if is_pawn and chess.square_rank(sq) == 7 and chess.Move(from_sq, sq, promotion=chess.QUEEN) in board.legal_moves:
            bot.edit_message_text(
                "اختر القطعة للترقية:", chat_id, call.message.message_id, 
                reply_markup=get_promotion_keyboard(from_sq, sq)
            )
            return

        move = chess.Move(from_sq, sq)
        if move in board.legal_moves:
            execute_move(chat_id, call.message.message_id, move)
        else:
            save_game(chat_id, board, game['white'], game['black'], selected_sq=None)
            bot.edit_message_reply_markup(chat_id, call.message.message_id, reply_markup=get_board_keyboard(board))

@bot.callback_query_handler(func=lambda call: call.data.startswith('prom_'))
def handle_promotion(call):
    chat_id = call.message.chat.id
    _, from_sq, to_sq, piece_code = call.data.split('_')
    piece_map = {'q': chess.QUEEN, 'r': chess.ROOK, 'b': chess.BISHOP, 'n': chess.KNIGHT}
    move = chess.Move(int(from_sq), int(to_sq), promotion=piece_map[piece_code])
    execute_move(chat_id, call.message.message_id, move)

def execute_move(chat_id, message_id, move):
    game = load_game(chat_id)
    board = game['board']
    board.push(move)
    save_game(chat_id, board, game['white'], game['black'], selected_sq=None)
    
    if board.is_checkmate():
        bot.edit_message_text("👑 كش مات! فزت باللعبة 🎉", chat_id, message_id, reply_markup=get_board_keyboard(board))
        delete_game(chat_id)
        return

    # حركة الذكاء الاصطناعي
    make_ai_move(chat_id, message_id)

def make_ai_move(chat_id, message_id):
    game = load_game(chat_id)
    board = game['board']
    legal_moves = list(board.legal_moves)
    
    if legal_moves:
        ai_move = legal_moves[0]
        board.push(ai_move)
        save_game(chat_id, board, game['white'], game['black'], selected_sq=None)
        
        if board.is_checkmate():
            bot.edit_message_text("👑 كش مات! فاز البوت.", chat_id, message_id, reply_markup=get_board_keyboard(board))
            delete_game(chat_id)
            return
            
        bot.edit_message_text(
            "تحرك البوت. دورك الآن (الأبيض):", 
            chat_id, message_id, reply_markup=get_board_keyboard(board)
        )

@bot.callback_query_handler(func=lambda call: call.data == "action_cancel")
def cancel_selection(call):
    chat_id = call.message.chat.id
    game = load_game(chat_id)
    if game:
        save_game(chat_id, game['board'], game['white'], game['black'], selected_sq=None)
        bot.edit_message_reply_markup(chat_id, call.message.message_id, reply_markup=get_board_keyboard(game['board']))

@bot.callback_query_handler(func=lambda call: call.data == "action_resign")
def resign_game(call):
    chat_id = call.message.chat.id
    delete_game(chat_id)
    bot.edit_message_text("🏳️ تم الاستسلام وإنهاء اللعبة.", chat_id, call.message.message_id)

